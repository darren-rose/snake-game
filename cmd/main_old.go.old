package main

import (
	"bytes"
	"fmt"
	"image/color"
	"log"
	"math"
	"math/rand"
	"os"
	"time"

	"github.com/hajimehoshi/ebiten/v2"
	"github.com/hajimehoshi/ebiten/v2/audio"
	"github.com/hajimehoshi/ebiten/v2/ebitenutil"
	"github.com/hajimehoshi/ebiten/v2/vector"
)

var (
	up    = Point{y: -1}
	down  = Point{y: 1}
	left  = Point{x: -1}
	right = Point{x: 1}
)

const (
	WIDTH                   = 320
	HEIGHT                  = 240
	GRID_SIZE               = 5
	MILLISECONDS_PER_UPDATE = time.Millisecond * 200
	AUDIO_SAMPLE_RATE       = 44100
	INFO_PANEL_HEIGHT       = 30
	GAME_AREA_HEIGHT        = HEIGHT - INFO_PANEL_HEIGHT
)

type Point struct {
	x, y int
}

type Game struct {
	snake          []Point
	direction      Point
	lastUpdate     time.Time
	lastScoreTime  time.Time
	food           Point
	lives          int
	score          int
	gameOver       bool
	deathPos       Point
	deathTime      time.Time
	explosions     []Explosion
	audioContext   *audio.Context
	level          int
	foodEaten      int
	updateInterval time.Duration
	lastMoveTime   time.Time
}

type Explosion struct {
	x, y     float64
	radius   float64
	timeLeft time.Duration
}

func (g *Game) Update() error {
	// Handle quit and restart keys when game is over
	if g.gameOver {
		if ebiten.IsKeyPressed(ebiten.KeyQ) {
			os.Exit(0)
		}
		if ebiten.IsKeyPressed(ebiten.KeyR) {
			g.reset()
		}
		return nil
	}

	// Update explosions
	for i := 0; i < len(g.explosions); i++ {
		g.explosions[i].timeLeft -= time.Millisecond * 16 // ~60fps
		g.explosions[i].radius += 2
		if g.explosions[i].timeLeft <= 0 {
			g.explosions = append(g.explosions[:i], g.explosions[i+1:]...)
			i--
		}
	}

	// Increment score by 1 every 5 seconds
	if time.Since(g.lastScoreTime) >= 5*time.Second {
		g.lastScoreTime = time.Now()
		g.score++
	}

	// Move snake based on current update interval
	if time.Since(g.lastUpdate) >= g.updateInterval {
		g.lastUpdate = time.Now()

		// Calculate new head position
		head := g.snake[0]
		head.x += g.direction.x
		head.y += g.direction.y

		// Check wall collision
		if head.x < 0 || head.x >= WIDTH/GRID_SIZE || head.y < 0 || head.y >= GAME_AREA_HEIGHT/GRID_SIZE {
			g.lives--
			g.deathPos = head
			g.deathTime = time.Now()
			g.createExplosion(head.x, head.y)
			g.playDieSound()
			if g.lives <= 0 {
				g.gameOver = true
			} else {
				// Reset snake to center
				g.snake = []Point{{x: WIDTH / GRID_SIZE / 2, y: HEIGHT / GRID_SIZE / 2}}
				g.direction = Point{x: 1}
			}
			return nil
		}

		// Check self collision
		for i := 1; i < len(g.snake); i++ {
			if g.snake[i].x == head.x && g.snake[i].y == head.y {
				g.lives--
				g.deathPos = head
				g.deathTime = time.Now()
				g.createExplosion(head.x, head.y)
				g.playDieSound()
				if g.lives <= 0 {
					g.gameOver = true
				} else {
					// Reset snake to center
					g.snake = []Point{{x: WIDTH / GRID_SIZE / 2, y: HEIGHT / GRID_SIZE / 2}}
					g.direction = Point{x: 1}
				}
				return nil
			}
		}

		// Insert new head
		g.snake = append([]Point{head}, g.snake...)
		g.playMoveSound()

		// Check food collision
		if head.x == g.food.x && head.y == g.food.y {
			// Grow snake (don't remove tail)
			g.score += 20
			g.foodEaten++
			g.playEatSound()

			// Check if level should increase
			if g.foodEaten%5 == 0 {
				g.level++
				g.updateInterval = time.Duration(float64(MILLISECONDS_PER_UPDATE) / (1.0 + float64(g.level-1)*0.1))
			}

			g.food = generateFood(g)
		} else {
			// Remove tail
			g.snake = g.snake[:len(g.snake)-1]
		}
	}

	if ebiten.IsKeyPressed(ebiten.KeyQ) {
		g.direction = up
	}

	if ebiten.IsKeyPressed(ebiten.KeyA) {
		g.direction = down
	}

	if ebiten.IsKeyPressed(ebiten.KeyO) {
		g.direction = left
	}

	if ebiten.IsKeyPressed(ebiten.KeyP) {
		g.direction = right
	}

	return nil
}

func (g *Game) reset() {
	g.snake = []Point{{x: WIDTH / GRID_SIZE / 2, y: (GAME_AREA_HEIGHT / GRID_SIZE) / 2}}
	g.direction = Point{x: 1}
	g.food = generateFood(g)
	g.lives = 3
	g.score = 0
	g.gameOver = false
	g.explosions = []Explosion{}
	g.lastUpdate = time.Now()
	g.lastScoreTime = time.Now()
	g.level = 1
	g.foodEaten = 0
	g.updateInterval = MILLISECONDS_PER_UPDATE
}

func generateFood(g *Game) Point {
	for {
		food := Point{
			x: rand.Intn(WIDTH / GRID_SIZE),
			y: rand.Intn(GAME_AREA_HEIGHT/GRID_SIZE) + 1, // +1 to avoid info panel
		}
		// Ensure food doesn't spawn on snake
		if !contains(g.snake, food) {
			return food
		}
	}
}

func contains(snake []Point, p Point) bool {
	for _, pt := range snake {
		if pt.x == p.x && pt.y == p.y {
			return true
		}
	}
	return false
}

func (g *Game) createExplosion(x, y int) {
	for i := 0; i < 8; i++ {
		exp := Explosion{
			x:        float64(x*GRID_SIZE + GRID_SIZE/2),
			y:        float64(y*GRID_SIZE + GRID_SIZE/2),
			radius:   5,
			timeLeft: 300 * time.Millisecond,
		}
		g.explosions = append(g.explosions, exp)
	}
}

func (g *Game) playEatSound() {
	if g.audioContext == nil {
		return
	}
	// Generate a beep sound (high pitch, short duration)
	samples := generateBeep(AUDIO_SAMPLE_RATE, 800, 100) // 800Hz for 100ms
	reader := bytes.NewReader(samples)
	player, err := audio.NewPlayer(g.audioContext, reader)
	if err != nil {
		return
	}
	player.SetVolume(0.3)
	player.Play()
}

func (g *Game) playDieSound() {
	if g.audioContext == nil {
		return
	}
	// Generate a buzz sound (low pitch, longer duration)
	samples := generateBeep(AUDIO_SAMPLE_RATE, 300, 200) // 300Hz for 200ms
	reader := bytes.NewReader(samples)
	player, err := audio.NewPlayer(g.audioContext, reader)
	if err != nil {
		return
	}
	player.SetVolume(0.5)
	player.Play()
}

func (g *Game) playMoveSound() {
	if g.audioContext == nil {
		return
	}
	// Generate a subtle move sound (medium pitch, very short)
	samples := generateBeep(AUDIO_SAMPLE_RATE, 500, 30) // 500Hz for 30ms
	reader := bytes.NewReader(samples)
	player, err := audio.NewPlayer(g.audioContext, reader)
	if err != nil {
		return
	}
	player.SetVolume(0.1)
	player.Play()
}

func generateBeep(sampleRate, frequency, durationMs int) []byte {
	samples := sampleRate * durationMs / 1000
	buf := make([]byte, samples*2) // 16-bit audio
	for i := 0; i < samples; i++ {
		s := math.Sin(2*math.Pi*float64(frequency)*float64(i)/float64(sampleRate)) * 0.3 * 32767
		sample := int16(s)
		buf[i*2] = byte(sample & 0xFF)
		buf[i*2+1] = byte((sample >> 8) & 0xFF)
	}
	return buf
}

func (g *Game) Draw(screen *ebiten.Image) {
	// Draw info panel background at top
	vector.DrawFilledRect(screen, 0, 0, float32(WIDTH), float32(INFO_PANEL_HEIGHT), color.RGBA{50, 50, 50, 255}, true)

	// Draw info panel text
	panelText := fmt.Sprintf("Lives: %d | Score: %d | Level: %d | Food: %d/5", g.lives, g.score, g.level, g.foodEaten%5)
	ebitenutil.DebugPrintAt(screen, panelText, 5, 5)

	// Draw game area background
	vector.DrawFilledRect(screen, 0, float32(INFO_PANEL_HEIGHT), float32(WIDTH), float32(GAME_AREA_HEIGHT), color.RGBA{20, 20, 20, 255}, true)

	// Draw snake (adjusted for info panel)
	for _, p := range g.snake {
		vector.DrawFilledRect(screen, float32(p.x*GRID_SIZE), float32(p.y*GRID_SIZE+INFO_PANEL_HEIGHT), float32(GRID_SIZE), float32(GRID_SIZE), color.RGBA{0, 255, 0, 255}, true)
	}

	// Draw food (adjusted for info panel)
	vector.DrawFilledRect(screen, float32(g.food.x*GRID_SIZE), float32(g.food.y*GRID_SIZE+INFO_PANEL_HEIGHT), float32(GRID_SIZE), float32(GRID_SIZE), color.RGBA{255, 0, 0, 255}, true)

	// Draw explosions (adjusted for info panel)
	for _, exp := range g.explosions {
		alpha := uint8(float64(exp.timeLeft) / float64(300*time.Millisecond) * 255)
		vector.DrawFilledCircle(screen, float32(exp.x), float32(exp.y+float64(INFO_PANEL_HEIGHT)), float32(exp.radius), color.RGBA{255, 165, 0, alpha}, true)
	}

	if g.gameOver {
		gameOverText := fmt.Sprintf("GAME OVER! Final Score: %d | Level: %d", g.score, g.level)
		ebitenutil.DebugPrintAt(screen, gameOverText, WIDTH/2-130, HEIGHT/2-10)
		ebitenutil.DebugPrintAt(screen, "Press R to restart or Q to quit", WIDTH/2-130, HEIGHT/2+10)
	}
}

func (g *Game) Layout(outsideWidth, outsideHeight int) (int, int) {
	return WIDTH, HEIGHT
}

func init() {
	rand.Seed(time.Now().UnixNano())
}

func main() {

	game := &Game{
		snake: []Point{
			{x: WIDTH / GRID_SIZE / 2, y: (GAME_AREA_HEIGHT / GRID_SIZE) / 2},
		},
		direction:      Point{x: 1},
		food:           generateFood(&Game{snake: []Point{{x: WIDTH / GRID_SIZE / 2, y: (GAME_AREA_HEIGHT / GRID_SIZE) / 2}}}),
		lives:          3,
		score:          0,
		gameOver:       false,
		explosions:     []Explosion{},
		lastScoreTime:  time.Now(),
		level:          1,
		foodEaten:      0,
		updateInterval: MILLISECONDS_PER_UPDATE,
	}

	// Initialize audio context
	ctx := audio.NewContext(AUDIO_SAMPLE_RATE)
	game.audioContext = ctx

	ebiten.SetWindowSize(WIDTH, HEIGHT)
	ebiten.SetWindowTitle("Snake")
	if err := ebiten.RunGame(game); err != nil {
		log.Fatal(err)
	}

}
